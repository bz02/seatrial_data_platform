# Copy to .env and fill in. Never commit .env.

# Public demo: sample data and one-click demo accounts. Set to false for real customers.
SEATRAIL_DEMO_MODE=true
# The URL people use to reach this server (used for the demo ERP recordings).
SEATRAIL_PUBLIC_URL=https://seatrial.ai
# Required behind HTTPS so session cookies are only sent over TLS.
SEATRAIL_COOKIE_SECURE=true
# Long random string. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SEATRAIL_SECRET_KEY=

# Model grading and the frontier-model baseline. Leave empty to use the built-in heuristic grader.
ANTHROPIC_API_KEY=
SEATRAIL_JUDGE=auto
SEATRAIL_JUDGE_MODEL=claude-opus-5-5
SEATRAIL_BASELINE_MODEL=claude-opus-5-5

# Marketplace economics
SEATRAIL_OPEN_MARKETPLACE=false
SEATRAIL_TAKE_RATE=0.15
SEATRAIL_EXPERT_REVENUE_SHARE=0.20
SEATRAIL_HARD_TASK_BONUS=1.5
SEATRAIL_DOUBLE_REVIEW_BELOW=0.8
